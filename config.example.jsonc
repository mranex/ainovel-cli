{
  // Provider, model và mức suy luận mặc định.
  // ★ Giá trị của "provider" phải là tên một key nằm trong "providers" bên dưới
  //   (đóng vai trò như con trỏ / 指针, không phải tên giao thức API) — nếu đổi
  //   provider, bắt buộc phải có mục trùng tên trong "providers", nếu không sẽ báo lỗi thiếu cấu hình.
  //   Khi đang chạy có thể dùng /config để quản lý Provider/Model và /model để chuyển đổi theo từng vai trò.
  "provider": "openrouter",
  "model": "google/gemini-2.5-flash",
  // Tùy chọn. Mức suy luận mặc định: off / low / medium / high / xhigh / max.
  // Bỏ qua hoặc để rỗng = không ghi đè, dùng mặc định của model/provider.
  "reasoning_effort": "medium",

  // Thư viện thông tin xác thực Provider. Key đặt tùy ý, dùng làm đích cho trường "provider" ở trên.
  // Các provider đã biết (openai/anthropic/gemini/openrouter/deepseek/qwen/glm/grok/mimo/ollama/bedrock)
  // có thể bỏ qua "type"; proxy tùy chỉnh bắt buộc khai báo rõ "type" để chỉ định giao thức API.
  "providers": {
    "openrouter": {
      "api_key": "sk-or-v1-xxx",
      "base_url": "https://openrouter.ai/api/v1",
      // Tùy chọn. Khai báo danh sách model hiện trong bảng /model và context_window riêng cho từng model;
      // mảng chuỗi cũ vẫn tương thích. json_schema ghi đè chế độ Structured Output gốc (true/false/bỏ qua).
      "models": [
        { "name": "google/gemini-3.0-flash", "context_window": 200000 },
        { "name": "google/gemini-3.1-pro", "context_window": 1000000 }
      ],
      // Tùy chọn. Tham số bổ sung truyền thẳng vào body mỗi request (ví dụ temperature/top_p/min_p
      // hoặc chat_template_kwargs). Chỉ áp dụng cho nhóm provider tương thích OpenAI.
      "extra_body": { "temperature": 0.8, "min_p": 0.05 },
      // Tùy chọn. Cấu hình cấp HTTP client (không vào request body), dùng cho proxy yêu cầu User-Agent/headers riêng.
      "extra": {
        "user_agent": "my-client/1.0",
        "headers": { "X-Custom-Client": "my-client" }
      }
    },
    "opencode-go": {
      // OpenCode Go gói tháng: tự động gắn header `x-opencode-session` theo từng cuộc hội thoại
      // và tự định tuyến đúng giao thức cho từng model (Chat / Responses / Anthropic / Gemini).
      // Có thể điền api_key tại đây hoặc đặt biến môi trường OPENCODE_API_KEY.
      "api_key": "oc_sk_xxx",
      "base_url": "https://opencode.ai/inference/go",
      "models": [
        { "name": "deepseek-v4-pro" },
        { "name": "deepseek-v4.1-flash" },
        { "name": "glm-5.3" },
        { "name": "kimi-k3.1-pro" },
        { "name": "mimo-v2.6-pro" },
        { "name": "qwen4-max" },
        { "name": "minimax-m3" },
        { "name": "gpt-6-luna" },
        { "name": "gemini-4-argon" }
      ]
    },
    "anthropic": {
      "api_key": "sk-ant-xxx",
      "models": [{ "name": "claude-sonnet-4-6", "json_schema": true }]
    },
    "ollama": {
      // ollama / bedrock / proxy có khai báo type có thể bỏ qua api_key
      // base_url cần có hậu tố /v1 (endpoint tương thích OpenAI của Ollama nằm dưới /v1)
      "base_url": "http://localhost:11434/v1",
      "models": [{ "name": "qwen3:14b", "context_window": 32768 }],
      // Tùy chọn. Thời gian chờ tối đa khi stream bị im lặng (Go duration, mặc định "5m"):
      // hữu ích cho model chạy local chậm (LocalAI/Ollama).
      "stream_idle_timeout": "15m"
    },
    "claude-code-proxy": {
      // Proxy Anthropic tùy chỉnh. Nếu upstream chỉ cho phép client Claude Code truy cập,
      // dùng extra để truyền user_agent / anthropic_beta / headers. base_url không cần /v1.
      "type": "anthropic",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com",
      "models": [{ "name": "claude-sonnet-4-6", "context_window": 1000000 }],
      "extra": {
        "user_agent": "claude-code/2.1.183",
        "anthropic_beta": "claude-code-20250219",
        "headers": {
          "X-Stainless-Lang": "js",
          "X-Stainless-Package-Version": "0.94.0",
          "X-Stainless-Runtime": "node"
        }
      }
    },
    "codex-proxy": {
      // Proxy OpenAI/NewAPI tùy chỉnh.
      "type": "openai",
      "api_key": "sk-xxx",
      "base_url": "https://proxy.example.com/v1",
      "models": [
        { "name": "gpt-5.4", "context_window": 400000, "json_schema": true },
        { "name": "gpt-5.4-mini" },
        { "name": "MiniMax-M3", "context_window": 1000000 }
      ],
      // Tùy chọn. Endpoint giao thức OpenAI: chat (mặc định /v1/chat/completions) hoặc responses (/v1/responses).
      "api": "responses",
      "extra": {
        "prompt_cache_params": true,
        "user_agent": "codex-tui/0.142.3 (Mac OS 26.5.1; arm64) Apple_Terminal/470.2 (codex-tui; 0.142.3)",
        "headers": {
          "Originator": "codex-tui",
          "Session_id": "replace-with-random-session-id",
          "X-Codex-Turn-Metadata": "replace-with-random-turn-metadata"
        }
      }
    }
  },

  // Tùy chọn. Ghi đè model theo từng vai trò; vai trò không khai báo sẽ dùng model mặc định ở trên.
  // Các vai trò hỗ trợ: architect / writer / editor / translator (dịch sang tiếng Việt).
  // Mẹo tối ưu: để writer/architect/editor dùng model Trung Quốc (DeepSeek/Qwen/GLM/MiMo) viết truyện tiếng Trung,
  // còn "translator" trỏ sang Gemini hoặc Claude để dịch bản hoàn thiện sang tiếng Việt mượt mà nhất!
  // "roles": {
  //   "architect": { "provider": "deepseek", "model": "deepseek-reasoner" },
  //   "writer": {
  //     "provider": "deepseek",
  //     "model": "deepseek-chat",
  //     "reasoning_effort": "medium",
  //     "fallbacks": [{ "provider": "openrouter", "model": "qwen/qwen3-235b-a22b" }]
  //   },
  //   "editor": { "provider": "deepseek", "model": "deepseek-chat" },
  //   "translator": { "provider": "openrouter", "model": "google/gemini-3.1-pro" }
  // },

  // Phong cách sáng tác tiếng Trung: default / suspense / fantasy / romance.
  "style": "default",

  // Cấu hình mặc định cho lớp dịch tiếng Việt (có thể bật/đổi nóng riêng theo từng truyện bằng lệnh /trans):
  // - genre: auto | tien_hiep | co_trang | fantasy (khử Hán-Việt tên Tây) | hien_dai
  // - tone: normal (phổ thông) | mature (18+ trưởng thành, giữ trọn độ nóng & cảm xúc)
  // - auto_translate: after_arc (sau khi Editor duyệt xong Arc) | after_commit (ngay sau mỗi chương) | manual (chỉ dịch khi gọi /translate)
  "translate": {
    "genre": "auto",
    "tone": "normal",
    "auto_translate": "after_arc"
  }

  // Context window dự phòng toàn cục (ưu tiên thấp hơn models[].context_window).
  // "context_window": 300000

  // Tùy chọn. Ngân sách tối đa cho mỗi cuốn truyện (USD). book_usd > 0 mới kích hoạt.
  // "budget": {
  //   "book_usd": 50,
  //   "warn_ratio": 0.8,
  //   "hard_stop": false
  // },

  // Tùy chọn. Thông báo khi chạy treo máy (mặc định bật thông báo hệ thống OS).
  // "notify": {
  //   "enabled": true,
  //   "events": ["run_end", "budget", "advance_gate", "stop_guard", "plan_start", "deadlock", "worker_failure"]
  // }

  // Tùy chọn. Đặt true để tắt kiểm tra phiên bản mới lúc khởi động.
  // "disable_update_check": false
}
